# Copy to .env and fill in. .env is git-ignored.

# Home Assistant base URL as the container can reach it. Use the final URL:
# if HA redirects (e.g. http -> https), renders fail because the redirect leaves this origin.
HA_URL=https://ha.example.com

# Time zone the dashboard is rendered in (the browser's clock). The HA app gets
# this from the Supervisor automatically; plain Docker defaults to UTC.
TZ=Europe/Copenhagen

# Long-lived access token (Profile -> Security). Use a dedicated user.
HA_TOKEN=

# Optional comma-separated path prefixes that may be rendered, e.g. vue-tests,lovelace/eink
# Empty allows any dashboard path on HA_URL.
ALLOWED_PATHS=

# 0 = close the browser after every render. >0 = keep it for that many idle seconds.
BROWSER_IDLE_SECONDS=0

# Maximum time for a render to become ready, in ms.
READY_TIMEOUT_MS=45000
